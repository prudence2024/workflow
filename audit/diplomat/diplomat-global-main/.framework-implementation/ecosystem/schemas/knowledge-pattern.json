{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/knowledge-pattern.json",
  "title": "Design knowledge pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "domain", "name", "summary", "status", "problem",
    "mechanism", "industries", "ux_goals", "contexts", "tags",
    "accessibility", "performance", "contraindications", "evidence", "scores",
    "first_seen", "last_observed", "last_evaluated", "reviewers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "domain": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "approved", "deprecated"]},
    "problem": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "composition_guidance": {"type": "array", "items": {"type": "string"}},
    "implementation_guidance": {"type": "array", "items": {"type": "string"}},
    "variants": {"type": "array", "items": {"type": "string"}},
    "related_patterns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "industries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ux_goals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contexts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "accessibility": {"$ref": "#/$defs/quality"},
    "performance": {"$ref": "#/$defs/quality"},
    "usability": {"$ref": "#/$defs/scoredQuality"},
    "conversion": {"$ref": "#/$defs/scoredQuality"},
    "contraindications": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_ids", "independent_source_groups", "positive", "negative", "contradictory"],
      "properties": {
        "observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "independent_source_groups": {"type": "integer", "minimum": 0},
        "positive": {"type": "array", "items": {"type": "string"}},
        "negative": {"type": "array", "items": {"type": "string"}},
        "contradictory": {"type": "array", "items": {"type": "string"}},
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "capture_id", "independence_group", "manifest"],
            "properties": {
              "source_id": {"type": "string"},
              "capture_id": {"type": "string"},
              "independence_group": {"type": "string"},
              "manifest": {"type": "string"}
            }
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula_version", "evidence_confidence", "recommendation_score", "confidence_level", "novelty", "explanation"],
      "properties": {
        "formula_version": {"type": "string", "minLength": 1},
        "evidence_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "recommendation_score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_level": {"enum": ["established", "contextual", "promising", "experimental", "discouraged"]},
        "novelty": {"type": "number", "minimum": 0, "maximum": 1},
        "explanation": {"type": "string", "minLength": 1},
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate", "final", "human_approval_required", "human_approval_recorded"],
          "properties": {
            "candidate": {"enum": ["established", "contextual", "promising", "experimental", "discouraged"]},
            "final": {"enum": ["established", "contextual", "promising", "experimental", "discouraged"]},
            "human_approval_required": {"type": "boolean"},
            "human_approval_recorded": {"type": "boolean"}
          }
        }
      }
    },
    "first_seen": {"type": "string", "format": "date"},
    "last_observed": {"type": "string", "format": "date"},
    "last_evaluated": {"type": "string", "format": "date"},
    "reviewers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "tags", "notes"],
      "properties": {
        "rating": {"enum": ["supports", "neutral", "risk", "unknown"]},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scoredQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "notes"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
