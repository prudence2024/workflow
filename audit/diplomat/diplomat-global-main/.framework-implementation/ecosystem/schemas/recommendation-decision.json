{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/recommendation-decision.json",
  "title": "Human decision on a skill recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recommendation_id", "decision", "reviewer", "decided_at", "reason", "scope"],
  "properties": {
    "schema_version": {"const": 1},
    "recommendation_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "decision": {"enum": ["approved", "rejected"]},
    "reviewer": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "scope": {"const": "this-recommendation-only"}
  }
}
