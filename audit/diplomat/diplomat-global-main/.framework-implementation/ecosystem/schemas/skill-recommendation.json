{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prudence.local/schemas/skill-recommendation.json",
  "title": "Recommendation-only first-party skill improvement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "affected_skill", "problem", "evidence",
    "proposed_change", "alternatives", "benefits", "expected_impact",
    "trade_offs", "confidence", "validation_plan", "status",
    "human_decision", "approval_required", "implementation_reference",
    "generated_at", "generator_version"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "affected_skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "revision_hash"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "revision_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "problem": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "claim_id", "canonical_url", "content_hash", "authority", "upstream_group"],
        "properties": {
          "source_id": {"type": "string"},
          "claim_id": {"type": "string"},
          "canonical_url": {"type": "string", "format": "uri"},
          "content_hash": {"type": "string"},
          "authority": {"enum": ["primary", "secondary", "community"]},
          "upstream_group": {"type": "string"}
        }
      }
    },
    "proposed_change": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "benefits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_impact": {"type": "string", "minLength": 1},
    "trade_offs": {
      "type": "object", "additionalProperties": false,
      "required": ["compatibility", "security", "maintenance", "context_cost", "other"],
      "properties": {
        "compatibility": {"type": "string"},
        "security": {"type": "string"},
        "maintenance": {"type": "string"},
        "context_cost": {"type": "string"},
        "other": {"type": "array", "items": {"type": "string"}}
      }
    },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "level", "explanation", "independent_source_groups"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "level": {"enum": ["low", "medium", "high"]},
        "explanation": {"type": "string", "minLength": 1},
        "independent_source_groups": {"type": "integer", "minimum": 1}
      }
    },
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["proposed", "approved", "rejected", "implemented", "superseded"]},
    "human_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "decision_record"],
      "properties": {
        "state": {"enum": ["pending", "approved", "rejected"]},
        "decision_record": {"type": ["string", "null"]}
      }
    },
    "approval_required": {"const": true},
    "implementation_reference": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator_version": {"const": "skill-learning-v1"}
  }
}
