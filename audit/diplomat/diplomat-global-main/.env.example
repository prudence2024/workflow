[TEMPLATE]
# ─── Clerk authentication ───────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/admin/login
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/admin
CLERK_AUTHORIZED_PARTIES=https://diplomatglobal.com,http://localhost:3000,http://localhost:5173

# ─── Admin bootstrap security ───────────────────────────────────
# The Clerk user ID authorized to claim first-owner when admin_users is empty.
# Find it in Clerk Dashboard → Users → your account → copy the "User ID".
# Server-side only — never exposed to the browser.
INITIAL_ADMIN_CLERK_USER_ID=

# ─── Supabase PostgreSQL / PostgREST ────────────────────────────
# (database only; never Supabase Auth or Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Dedicated server-only secret used to HMAC-hash guest review-claim tokens.
# NEVER reuse a provider key (Paystack/Clerk/Supabase/receipt). Required for
# Verified-Purchase claim issuance/redemption.
REVIEW_CLAIMS_HASH_SECRET=

# ─── Cloudinary media ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Transactional email (Resend) ──────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Diplomat Global <notifications@mail.your-domain.example>
CONTACT_OWNER_EMAIL=support@diplomatglobal.com.ng

# ─── Marketing email (Brevo) ───────────────────────────────────
BREVO_API_KEY=
BREVO_MARKETING_LIST_ID=

# ─── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Application ────────────────────────────────────────────────
VITE_SITE_URL=https://diplomatglobal.com

# ─── Paystack payments ──────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── Telegram Bot (admin payment notifications — server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Vercel Analytics ───────────────────────────────────────────
VERCEL_ANALYTICS_ID=

# ─── Sentry error tracking ─────────────────────────────────────
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_RELEASE=
SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
