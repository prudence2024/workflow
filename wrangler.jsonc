{
  // Cloudflare Workers preview scaffold — DEVELOPMENT branch, TEST credentials only.
  //
  // STATUS: runtime is Workers-ready (edge Neon transport selected by the
  // DATABASE_RUNTIME var below; see docs/CLOUDFLARE-PREVIEW.md). Staging may
  // only ever point at development/test resources. Do not point this at
  // production.
  "$schema": "https://developers.cloudflare.com/schemas/config/wrangler.jsonc",
  "name": "workflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Workers Static Assets: serves the OpenNext client chunks, CSS and images
  // built into .open-next/assets. Without this binding every hashed client
  // asset 404s and pages render without hydration or styling.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Selects the Neon WebSocket transport in src/db (TCP does not exist on
    // Workers). Node runtimes (dev, scripts, tests, migrations) ignore it.
    "DATABASE_RUNTIME": "edge",
    "NEXT_PUBLIC_APP_URL": "https://workflow-preview.example.test",
    "NEON_BRANCH": "development",
    "CLERK_AUTHORIZED_PARTIES": "https://workflow-preview.example.test",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/login",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/signup"
  },
  // Preview deployments (testing branch) require their own vars block.
  // Values mirror top-level vars but use the real branch preview origin so
  // absolute URLs, Clerk authorized parties and callbacks resolve to the
  // staging deployment — never production. No secrets in this file.
  "previews": {
    "vars": {
      "DATABASE_RUNTIME": "edge",
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_c3dlZXBpbmctZ3JvdXNlLTYzNTMuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "NEXT_PUBLIC_APP_URL": "https://testing-workflow.okwuborprudence.workers.dev",
      "NEON_BRANCH": "development",
      "CLERK_AUTHORIZED_PARTIES": "https://testing-workflow.okwuborprudence.workers.dev",
      "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/login",
      "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/signup"
    }
  },
  // Durable non-production staging environment. Deploy with
  // `wrangler deploy --env testing`; its secrets are scoped to the separate
  // workflow-testing Worker and are never read from or written to production.
  "env": {
    "testing": {
      "name": "workflow-testing",
      "workers_dev": true,
      "vars": {
        "DATABASE_RUNTIME": "edge",
        "BUILD_GIT_SHA": "f3f2482140a4d5ddaa728ccac2c42170af8a3f08",
        "NEXT_PUBLIC_APP_URL": "https://workflow-testing.okwuborprudence.workers.dev",
        "NEON_BRANCH": "development",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_c3dlZXBpbmctZ3JvdXNlLTYzNTMuY2xlcmsuYWNjb3VudHMuZGV2JA",
        "CLERK_AUTHORIZED_PARTIES": "https://workflow-testing.okwuborprudence.workers.dev",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/login",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/signup"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "99bc46e2b05a47f4a2a732f46a9ab6af"
        }
      ]
    }
  }
  // Secrets (set with `wrangler secret put`, NEVER in this file):
  //   DATABASE_URL (pooled Neon DEVELOPMENT endpoint)
  //   DATABASE_URL_UNPOOLED (direct Neon DEVELOPMENT endpoint, migrations only)
  //   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (pk_test_…)
  //   CLERK_SECRET_KEY (sk_test_…)
  //   WORKER_SECRET, RESEND_*, TERMII_*, TELEGRAM_*, R2_* (test credentials only)
}
