# ─────────────────────────────────────────────────────────────
# Workflow — environment template. NO REAL SECRETS IN THIS FILE.
# Copy to .env.local for development. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ─── Neon PostgreSQL (single database, org-scoped tables + RLS) ───
# Pooled endpoint for the application runtime (host contains "-pooler").
DATABASE_URL=
# Direct endpoint for Drizzle migrations and privileged maintenance only.
DATABASE_URL_UNPOOLED=

# ─── Clerk identity ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: restricts Clerk session tokens to your own origins.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ─── Restricted platform-admin bootstrap ───────────────────────
# The Clerk user id allowed to claim platform-admin. Server-side only.
# Never settable from the browser or writable profile metadata.
PLATFORM_ADMIN_CLERK_USER_ID=

# ─── Transactional email (Resend) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Workflow <notifications@example.com>
RESEND_WEBHOOK_SIGNING_SECRET=

# ─── SMS (Termii adapter) ───────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_WEBHOOK_SECRET=

# ─── Telegram founder bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids allowed to use the bot (fail-closed if empty).
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# ─── Background jobs / scheduling (Trigger.dev) ────────────────
# Server-side secret key used by the SDK to trigger tasks and read runs.
TRIGGER_SECRET_KEY=
# Project ref (e.g. proj_abc123). Public; also set in trigger.config.ts.
TRIGGER_PROJECT_REF=
# Only for self-hosted Trigger.dev instances. Leave blank for Trigger.dev Cloud.
TRIGGER_API_URL=

# ─── File storage (Cloudinary public images / R2 private files) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Cache and rate limiting (Upstash Redis) ────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Monitoring (Sentry) ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
